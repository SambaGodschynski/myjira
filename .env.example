# Copy to ~/.config/myjira/.env and fill in your own values. Keep it out of the
# checkout: these are full session credentials for your account, and a file
# sitting next to the source is one stray `git add -f` away from being public.
#
# JIRA_COOKIE is the complete Cookie header from your own logged-in session,
# pasted verbatim — the whole "_ga=…; JSESSIONID=…; tenant.session.token=…"
# string, not a single cookie. Paste it as it is: everything after the first "="
# is the value, so the header's own ";", spaces and "=" need no quoting and no
# escaping. Quotes are accepted and stripped if you prefer them. See the README
# for how to grab it.
JIRA_SITE=https://digitalklang.atlassian.net
JIRA_COOKIE=

# More orgs: add a JIRA_SITE_<NAME>/JIRA_COOKIE_<NAME> pair per org. The suffix
# is the name the commands show and that --org=<name> takes, and each org needs
# its own cookie — a session is only ever valid for the host it was issued for.
# An on-premise Jira works the same way.
#JIRA_SITE_GD=https://jira.example.com
#JIRA_COOKIE_GD=

# Which org the commands act on when they aren't told. Only needed once there
# is more than one: with a single org configured, that one is it. --org=<name>
# overrides this per command.
#DEFAULT_ORG=digitalklang
